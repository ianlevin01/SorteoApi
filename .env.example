# Copiá este archivo a  .env  y completá los valores.
# En producción (NODE_ENV=production) el server NO arranca si faltan:
#   JWT_SECRET, S3_BUCKET, PAYMENT_ALIAS, CORS_ORIGIN (dominio real)

# ================= Servidor =================
PORT=4001
NODE_ENV=development
# Origenes permitidos para CORS (separados por coma).
#   dev:  http://localhost:5180
#   prod: https://renattosorteo.com,https://www.renattosorteo.com
CORS_ORIGIN=http://localhost:5180

# ================= Sesion / Auth =================
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=30d
# DNIs que quedan como administradores al iniciar sesion (separados por coma)
ADMIN_DNIS=

# ================= AWS =================
AWS_REGION=sa-east-1
# Claves de un usuario IAM con permisos DynamoDB + S3 (ver docs/aws-iam-policy.json).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # solo credenciales temporarias
# AWS_PROFILE=sorteo          # alternativa: usar un perfil de la AWS CLI

# ================= DynamoDB =================
# dev: sorteo_dev_   |   prod: sorteo_prod_
DYNAMO_TABLE_PREFIX=sorteo_dev_
# DYNAMO_ENDPOINT=http://localhost:8000   # solo DynamoDB Local

# ================= S3 =================
# Bucket PRIVADO para los comprobantes de transferencia.
S3_BUCKET=
S3_RECEIPTS_PREFIX=receipts/
# Bucket PUBLICO para imagenes de premios/ganadores (se ven en el sitio).
MEDIA_BUCKET=
MEDIA_PREFIX=img/
# MEDIA_PUBLIC_BASE_URL=   # opcional (ej. si usas CloudFront)

# ================= Datos de pago (transferencia) =================
PAYMENT_ALIAS=
PAYMENT_CBU=
PAYMENT_HOLDER=
PAYMENT_BANK=

# ================= Verificacion de comprobantes (OpenAI) =================
# Sin OPENAI_API_KEY, todos los comprobantes van a revision manual.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=45000
RECEIPT_CHECK_ENABLED=true
RECEIPT_CHECK_AUTOAPPROVE=true
RECEIPT_CHECK_MIN_CONFIDENCE=0.7
RECEIPT_CHECK_MAX_ATTEMPTS=3
RECEIPT_CHECK_MAX_AGE_DAYS=10

# Sorteos "elegí tu número": minutos que se reserva un número al tocarlo.
PICK_RESERVATION_MINUTES=30
# Mientras el comprobante de esos números está en revisión manual, se
# sostiene la reserva (no se libera) por esta cantidad de horas.
PICK_REVIEW_HOLD_HOURS=72
