{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTablas",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:TransactGetItems"
      ],
      "Resource": [
        "arn:aws:dynamodb:sa-east-1:ACCOUNT_ID:table/sorteo_dev_*",
        "arn:aws:dynamodb:sa-east-1:ACCOUNT_ID:table/sorteo_dev_*/index/*"
      ]
    },
    {
      "Sid": "S3Comprobantes",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:HeadBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketCORS",
        "s3:GetBucketLocation",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::NOMBRE_DEL_BUCKET",
        "arn:aws:s3:::NOMBRE_DEL_BUCKET/*"
      ]
    }
  ]
}
